# Neon Postgres
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# NextAuth v5 (Auth.js)
# AUTH_SECRET ayrıca e-posta doğrulama kodları / token'ları için HMAC pepper'ı
# olarak da kullanılır (ayrı bir değişken gerekmez).
AUTH_SECRET=

# Sitenin canonical URL'i. E-postalardaki doğrulama/sıfırlama linkleri YALNIZ
# buradan üretilir (Host başlığından asla türetilmez — host header poisoning'e
# karşı). Üretimde zorunlu; boşsa VERCEL_URL, o da yoksa localhost kullanılır.
NEXT_PUBLIC_SITE_URL=

# E-posta gönderimi (SMTP). Boş bırakılırsa dev'de kod/link konsola loglanır
# (mailer sağlayıcı-bağımsız: Resend/SES için drop-in). Gmail App Password ile:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465. Not: kişisel Gmail ~500 mail/gün ve
# SPF/DKIM hizalaması olmadan spam riski taşır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sepet <no-reply@example.com>"

# TOTP 2FA secret şifreleme anahtarı (AES-256-GCM). 32 bayt base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel AI Gateway (Google Gemini)
AI_GATEWAY_API_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Marketfiyati (TÜBİTAK + Ticaret Bakanlığı)
# Kullanıcı konumu yoksa kullanılan fallback koordinatlar
MARKETFIYATI_DEFAULT_LAT=41.064950
MARKETFIYATI_DEFAULT_LNG=28.983262
MARKETFIYATI_DEFAULT_DISTANCE=10

# Cloudflare R2 (fiş görselleri)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sepetiq-receipts
# Public base URL — özel domain (https://receipts.example.com) ya da R2 public bucket URL.
# Sondaki "/" olmadan, key bu base'in altına eklenir.
R2_PUBLIC_BASE_URL=

# /api/cron/purge-archived
CRON_SECRET=

# Polar (abonelik / ödeme)
# Organization Access Token (Polar Dashboard → Settings → Developers)
POLAR_ACCESS_TOKEN=
POLAR_SERVER=production
# Webhook endpoint secret (Polar Dashboard → Settings → Webhooks → endpoint)
POLAR_WEBHOOK_SECRET=
# Pro ürün ID'leri (Polar Dashboard → Products)
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_PRO_YEARLY=